# ==============================================================
# AI-Ready Enterprise Data Platform - Environment Configuration
# ==============================================================

# Model Provider Selection: "azure_openai", "openai", "gemini", or "mock"
LLM_PROVIDER=mock
EMBEDDING_PROVIDER=mock

# Azure OpenAI Configuration (nếu dùng Azure)
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# OpenAI Direct Configuration (nếu dùng OpenAI)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_NAME=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Google Gemini Configuration (nếu dùng Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-1.5-pro

# Cube Semantic Layer Configuration
CUBE_API_URL=http://localhost:4000/cubejs-api/v1
CUBE_API_SECRET=enterprise_super_secret_cube_token_2026
CUBE_DEV_MODE=true

# Qdrant Vector Database
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=rag-chunks-index-v1

# Redis FinOps Cache & Checkpointer
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security & JWT Configuration
JWT_SECRET_KEY=enterprise_jwt_secret_key_change_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=480

# Langfuse Observability
LANGFUSE_PUBLIC_KEY=pk-lf-local-test
LANGFUSE_SECRET_KEY=sk-lf-local-test
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_ENABLED=false

# Storage & Paths
DATA_DIR=./data
LAKEHOUSE_PATH=./data/lakehouse
